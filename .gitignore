# CICIDS dataset (too large for git, download separately).
# Anchored to the repo root — an unanchored "data/" also swallowed
# frontend/src/data/, which silently kept the dashboard's bundled
# evaluation JSONs out of git and broke the CI build.
/data/
*.csv
*.pcap

# Model artifacts (except the small exported serving artifacts,
# which are committed so the deployed Space works without retraining)
*.pth
*.onnx
*.pkl
!backend/artifacts/model.onnx

# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Editor
.vscode/
.idea/
.DS_Store

# Environment
.env
